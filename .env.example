# Circa optional Compose provider (server-side only)
AI_PROVIDER=NOT_CONFIGURED
AI_API_URL=PASTE_SERVER_SIDE_PROVIDER_URL_HERE
AI_API_KEY=PASTE_SERVER_SIDE_AI_KEY_HERE

# Firebase Web SDK (public client configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=PASTE_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=PASTE_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=PASTE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=PASTE_PROJECT.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PASTE_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=PASTE_WEB_APP_ID
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=PASTE_RECAPTCHA_ENTERPRISE_SITE_KEY
# Development only. Uses Firebase's generated debug token; never paste a token here.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=false

# Privileged Netlify server routes (never expose these as NEXT_PUBLIC variables)
FIREBASE_PROJECT_ID=PASTE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_JSON=PASTE_MINIFIED_SERVICE_ACCOUNT_JSON_OR_USE_ADC
RATE_LIMIT_HMAC_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
COMPOSE_REQUIRE_APPCHECK=false
ACCOUNT_REQUIRE_APPCHECK=false
