rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function permanentUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function projectPath(projectId) { return /databases/$(database)/documents/projects/$(projectId); }
    function memberPath(projectId, uid) { return /databases/$(database)/documents/projects/$(projectId)/members/$(uid); }
    function contributionPath(projectId, uid) { return /databases/$(database)/documents/projects/$(projectId)/networkContributions/$(uid); }
    function contributionEnabled(projectId, uid) { return exists(contributionPath(projectId, uid)) && get(contributionPath(projectId, uid)).data.enabled == true; }
    function invitePath(inviteId) { return /databases/$(database)/documents/invites/$(inviteId); }
    function itemPath(projectId, listId, itemId) { return /databases/$(database)/documents/projects/$(projectId)/lists/$(listId)/items/$(itemId); }
    function project(projectId) { return get(projectPath(projectId)).data; }
    function projectAfter(projectId) { return getAfter(projectPath(projectId)).data; }
    function member(projectId, uid) { return get(memberPath(projectId, uid)).data; }
    function memberAfter(projectId, uid) { return getAfter(memberPath(projectId, uid)).data; }
    function activeMember(projectId) { return signedIn() && exists(memberPath(projectId, request.auth.uid)) && member(projectId, request.auth.uid).status == 'active'; }
    function activeMemberAfter(projectId) { return signedIn() && existsAfter(memberPath(projectId, request.auth.uid)) && memberAfter(projectId, request.auth.uid).status == 'active'; }
    function admin(projectId) { return activeMember(projectId) && member(projectId, request.auth.uid).role in ['owner', 'admin']; }
    function adminAfter(projectId) { return activeMemberAfter(projectId) && memberAfter(projectId, request.auth.uid).role in ['owner', 'admin']; }
    function owner(projectId) { return signedIn() && project(projectId).ownerId == request.auth.uid; }
    function ownerAfter(projectId) { return signedIn() && projectAfter(projectId).ownerId == request.auth.uid; }
    function safeProjectMode(value) { return value in ['map', 'community', 'network']; }
    function validInvite(inviteId, projectId) {
      return inviteId is string && inviteId.size() > 20 && exists(invitePath(inviteId)) &&
        get(invitePath(inviteId)).data.projectId == projectId &&
        get(invitePath(inviteId)).data.status == 'active' &&
        (get(invitePath(inviteId)).data.expiresAt == null || get(invitePath(inviteId)).data.expiresAt > request.time);
    }
    function proposalItemFields(value) {
      return value is map && value.keys().hasOnly(['title', 'details', 'description', 'category', 'itemType', 'phone', 'email', 'url', 'website', 'address', 'notes', 'openingInformation', 'date', 'startDate', 'startTime', 'endTime', 'location', 'schoolType', 'binType', 'schedule', 'timezone', 'areaLabel', 'enabled', 'customFields', 'order', 'contentVersion', 'schemaVersion']);
    }
    function validProposalBase(projectId) {
      return (request.resource.data.operation == 'create' && request.resource.data.itemId == '' && request.resource.data.currentItem == null && request.resource.data.baseVersion == 0 && proposalItemFields(request.resource.data.proposedItem)) ||
        (request.resource.data.operation in ['update', 'delete'] && request.resource.data.itemId is string && request.resource.data.itemId.size() > 0 && exists(itemPath(projectId, request.resource.data.listId, request.resource.data.itemId)) && request.resource.data.currentItem == get(itemPath(projectId, request.resource.data.listId, request.resource.data.itemId)).data && request.resource.data.baseVersion == get(itemPath(projectId, request.resource.data.listId, request.resource.data.itemId)).data.get('contentVersion', 0) && (request.resource.data.operation == 'delete' ? request.resource.data.proposedItem == null : proposalItemFields(request.resource.data.proposedItem)));
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && request.resource.data.uid == userId;
      allow delete: if false;
      match /memberships/{projectId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && (request.auth.uid == userId || adminAfter(projectId)) &&
          existsAfter(memberPath(projectId, userId)) && request.resource.data.status == memberAfter(projectId, userId).status &&
          request.resource.data.role == memberAfter(projectId, userId).role && request.resource.data.projectId == projectId &&
          request.resource.data.projectMode in ['community', 'network'];
        allow delete: if false;
      }
      match /{document=**} { allow read, write: if false; }
    }

    match /projects/{projectId} {
      allow get: if signedIn() && (resource.data.ownerId == request.auth.uid || activeMember(projectId));
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if permanentUser() && request.resource.data.ownerId == request.auth.uid && safeProjectMode(request.resource.data.projectMode) && request.resource.data.schemaVersion is int;
      allow update: if admin(projectId) && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.projectMode == resource.data.projectMode;
      // Owner deletion and ownership transfer require a dedicated trusted lifecycle
      // operation. They are deliberately unavailable as arbitrary client writes.
      allow delete: if false;

      match /members/{memberId} {
        allow get: if signedIn() && (request.auth.uid == memberId || admin(projectId));
        allow list: if admin(projectId) || (activeMember(projectId) && project(projectId).projectMode == 'network');
        allow create: if signedIn() && memberId == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'active' && request.resource.data.consented == true && request.resource.data.consentVersion is int && request.resource.data.consentedAt == request.time && request.resource.data.joinedAt == request.time && (
          (ownerAfter(projectId) && permanentUser() && request.resource.data.role == 'owner' && request.resource.data.joinedViaInviteId == '') ||
          (request.resource.data.role == 'member' && validInvite(request.resource.data.joinedViaInviteId, projectId))
        );
        allow update: if request.resource.data.uid == resource.data.uid && request.resource.data.joinedAt == resource.data.joinedAt && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'displayName', 'isAnonymous', 'notificationPreferences', 'joinedViaInviteId', 'consented', 'consentedAt', 'consentVersion', 'updatedAt', 'schemaVersion']) && (
          (admin(projectId) && resource.data.role != 'owner' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'updatedAt']) && request.resource.data.updatedAt == request.time && request.resource.data.status in ['active', 'removed'] && (request.resource.data.role == resource.data.role || owner(projectId))) ||
          (signedIn() && request.auth.uid == memberId && resource.data.status == 'removed' && resource.data.role == 'member' && request.resource.data.status == 'active' && request.resource.data.role == 'member' && request.resource.data.consented == true && request.resource.data.consentedAt == request.time && request.resource.data.updatedAt == request.time && validInvite(request.resource.data.joinedViaInviteId, projectId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'displayName', 'isAnonymous', 'joinedViaInviteId', 'consented', 'consentedAt', 'consentVersion', 'updatedAt', 'schemaVersion'])) ||
          (signedIn() && request.auth.uid == memberId && resource.data.status == 'active' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'notificationPreferences', 'updatedAt']))
        );
        allow delete: if false;
      }

      // Safe member directory: contains only display name, role/status and join date.
      // Community members may list this collection without exposing private membership metadata.
      match /memberDirectory/{memberId} {
        allow read: if activeMember(projectId);
        allow create, update: if activeMemberAfter(projectId) && existsAfter(memberPath(projectId, memberId)) &&
          request.resource.data.uid == memberId &&
          request.resource.data.role == memberAfter(projectId, memberId).role &&
          request.resource.data.status == memberAfter(projectId, memberId).status &&
          request.resource.data.keys().hasOnly(['uid', 'displayName', 'role', 'status', 'joinedAt', 'updatedAt', 'schemaVersion']) &&
          (request.auth.uid == memberId || adminAfter(projectId));
        allow delete: if false;
      }

      match /lists/{listId} {
        allow read: if activeMember(projectId);
        allow create, update, delete: if adminAfter(projectId);
        match /items/{itemId} {
          allow read: if activeMember(projectId);
          allow create, update: if adminAfter(projectId);
          allow delete: if adminAfter(projectId);
        }
      }

      match /editProposals/{proposalId} {
        allow create: if activeMember(projectId) && request.resource.data.keys().hasOnly(['projectId', 'listId', 'itemId', 'operation', 'currentItem', 'proposedItem', 'baseVersion', 'reason', 'status', 'submittedBy', 'submittedByName', 'submittedAt', 'schemaVersion']) && request.resource.data.projectId == projectId && request.resource.data.listId is string && request.resource.data.listId.size() > 0 && request.resource.data.submittedBy == request.auth.uid && request.resource.data.submittedByName is string && request.resource.data.submittedByName.size() > 0 && request.resource.data.submittedByName.size() <= 180 && request.resource.data.reason is string && request.resource.data.reason.size() <= 500 && request.resource.data.status == 'pending' && request.resource.data.operation in ['create', 'update', 'delete'] && request.resource.data.submittedAt == request.time && request.resource.data.schemaVersion == 3 && validProposalBase(projectId);
        allow read: if admin(projectId) || (signedIn() && resource.data.submittedBy == request.auth.uid);
        allow update: if admin(projectId) && resource.data.status == 'pending' && resource.data.submittedBy != request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote']) && request.resource.data.status in ['approved', 'rejected'] && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 500;
        allow delete: if false;
      }

      match /moderationEvents/{eventId} {
        allow read: if admin(projectId);
        allow create: if signedIn() && request.resource.data.keys().hasOnly(['action', 'actorUid', 'targetId', 'details', 'schemaVersion', 'createdAt']) && request.resource.data.actorUid == request.auth.uid && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0 && request.resource.data.targetId.size() <= 200 && request.resource.data.details is map && request.resource.data.schemaVersion == 1 && request.resource.data.createdAt == request.time && request.resource.data.action in ['membership-created', 'membership-rejoined', 'member-left', 'member-removed', 'member-role-changed', 'ownership-transferred', 'list-published', 'item-published', 'item-updated', 'item-deleted', 'directory-import-published', 'proposal-approved', 'proposal-rejected', 'invitation-created', 'invitation-revoked'] && (adminAfter(projectId) || (request.resource.data.action in ['membership-created', 'membership-rejoined'] && request.resource.data.targetId == request.auth.uid && activeMemberAfter(projectId)));
        allow update, delete: if false;
      }

      match /invitations/{inviteId} { allow read, create, update: if admin(projectId); allow delete: if owner(projectId); }
      match /mapPeople/{recordId} { allow read: if activeMember(projectId); allow create, update, delete: if adminAfter(projectId); }
      match /mapRelationships/{recordId} { allow read: if activeMember(projectId); allow create, update, delete: if adminAfter(projectId); }
      match /mapGroups/{recordId} { allow read: if activeMember(projectId); allow create, update, delete: if adminAfter(projectId); }
      match /mapNotes/{recordId} { allow read: if activeMember(projectId); allow create, update, delete: if adminAfter(projectId); }

      match /networkImports/{importId} {
        allow read: if signedIn() && resource.data.importedBy == request.auth.uid;
        allow create: if permanentUser() && activeMemberAfter(projectId) && projectAfter(projectId).projectMode == 'network' && request.resource.data.importedBy == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.importedBy == request.auth.uid;
      }
      match /networkPeople/{personId} {
        allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || (activeMember(projectId) && contributionEnabled(projectId, resource.data.ownerUid)));
        allow create: if permanentUser() && activeMemberAfter(projectId) && projectAfter(projectId).projectMode == 'network' && request.resource.data.ownerUid == request.auth.uid && request.resource.data.visibility in ['private', 'project'] && !request.resource.data.keys().hasAny(['email', 'personalNotes', 'privateMetadata']);
        allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && !request.resource.data.keys().hasAny(['email', 'personalNotes', 'privateMetadata']);
        allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }
      match /networkEdges/{edgeId} {
        allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || (activeMember(projectId) && contributionEnabled(projectId, resource.data.ownerUid)));
        allow create: if permanentUser() && activeMemberAfter(projectId) && projectAfter(projectId).projectMode == 'network' && request.resource.data.ownerUid == request.auth.uid && request.resource.data.visibility in ['private', 'project'];
        allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }
      match /networkPrivateFields/{personId} {
        allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
        allow create: if permanentUser() && activeMemberAfter(projectId) && request.resource.data.ownerUid == request.auth.uid;
        allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }
      match /networkContributions/{memberId} {
        allow read: if activeMember(projectId);
        allow create, update: if signedIn() && memberId == request.auth.uid && activeMemberAfter(projectId) && request.resource.data.ownerUid == request.auth.uid && request.resource.data.enabled is bool;
        allow delete: if signedIn() && memberId == request.auth.uid;
      }
      match /reminders/{reminderId} {
        allow read: if activeMember(projectId);
        allow create, update, delete: if admin(projectId);
      }
    }

    match /invites/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if signedIn() && admin(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt', 'updatedAt']);
      allow delete: if false;
    }
    match /joinCodes/{code} {
      allow get, list, create: if false;
      allow update: if signedIn() && admin(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt', 'updatedAt']);
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
