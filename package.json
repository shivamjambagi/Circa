{
  "name": "circa-friend-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "node node_modules/vinext/dist/cli.js dev",
    "build": "node scripts/build.mjs",
    "start": "node node_modules/vinext/dist/cli.js start",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:firestore && npm run build && npm run test:critical",
    "test:unit": "node scripts/run-tests.mjs",
    "test:firestore": "node scripts/run-firestore-tests.mjs",
    "test:critical": "node scripts/critical-e2e.mjs",
    "ci:collect-security-report": "node scripts/collect-gitleaks-report.mjs",
    "check:clean": "node scripts/check-clean-worktree.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "scan:artifact": "node scripts/scan-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "firebase": "^12.16.0",
    "firebase-admin": "14.3.0",
    "next": "16.3.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.3",
    "@firebase/rules-unit-testing": "5.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "15.26.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.121.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    }
  },
  "type": "module",
  "displayName": "Circa"
}
